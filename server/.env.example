# Server ONLY. Copy to root .env.server.local or use hosting secret settings.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
YOUTUBE_API_KEY=
# Optional; only numerically qualified top 3 videos/run may use AI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Voice endpoints only. Keep these and OPENAI_API_KEY on the existing backend.
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_VOICE_EDIT_MODEL=gpt-6.1-terra
RESEARCH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8787
